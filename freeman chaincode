import numpy as np
import matplotlib.pyplot as plt
import networkx as nx
from skimage.morphology import skeletonize
from skimage.measure import regionprops, label
import csv
import os

# ==================== DIRECTION MAP ====================
DIRECTION_MAP = {
    (0, 1): 0, (-1, 1): 1, (-1, 0): 2, (-1, -1): 3,
    (0, -1): 4, (1, -1): 5, (1, 0): 6, (1, 1): 7
}

def get_freeman_direction(p1, p2):
    dy = p2[0] - p1[0]
    dx = p2[1] - p1[1]
    return DIRECTION_MAP.get((dy, dx), -1)

# ==================== SKELETON TO GRAPH ====================
def skeleton_to_graph(skel):
    G = nx.Graph()
    for y in range(skel.shape[0]):
        for x in range(skel.shape[1]):
            if skel[y, x]:
                for dy in [-1, 0, 1]:
                    for dx in [-1, 0, 1]:
                        if dy == 0 and dx == 0:
                            continue
                        ny, nx_ = y + dy, x + dx
                        if 0 <= ny < skel.shape[0] and 0 <= nx_ < skel.shape[1] and skel[ny, nx_]:
                            G.add_edge((y, x), (ny, nx_))
    return G

def dfs_traverse(G, start):
    visited = set()
    path = []
    def dfs(u):
        visited.add(u)
        path.append(u)
        for v in sorted(G.neighbors(u), key=lambda p: (-p[1], p[0])):
            if v not in visited:
                dfs(v)
    dfs(start)
    return path

def fallback_path(G, endpoints):
    max_len = 0
    best_path = []
    for i in range(len(endpoints)):
        for j in range(i + 1, len(endpoints)):
            u, v = endpoints[i], endpoints[j]
            if nx.has_path(G, u, v):
                try:
                    p = nx.shortest_path(G, source=u, target=v)
                    if len(p) > max_len:
                        max_len = len(p)
                        best_path = p
                except:
                    continue
    return best_path

