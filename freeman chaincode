for idx, region_mask in enumerate(sorted_hasil_potongan):
    skel = skeletonize(region_mask)
    G = skeleton_to_graph(skel)
    endpoints_G = [node for node in G.nodes if G.degree[node] == 1]
    loop_list = nx.cycle_basis(G)

    path = []

    if loop_list:
        prefer_start = sorted(G.nodes, key=lambda p: (-p[1], p[0]))[0]
        path = dfs_traverse(G, prefer_start)
        print(f"Huruf ke-{idx+1}: LOOP detected → DFS dari {prefer_start}")
    elif len(endpoints_G) >= 2:
        prefer_start = sorted(endpoints_G, key=lambda p: (-p[1], p[0]))[0]
        prefer_end = sorted(endpoints_G, key=lambda p: (p[1], -p[0]))[0]
        if nx.has_path(G, prefer_start, prefer_end):
            path = nx.shortest_path(G, source=prefer_start, target=prefer_end)
        else:
            print(f"Huruf ke-{idx+1}: fallback dipakai.")
            path = fallback_path(G, endpoints_G)
    else:
        points = np.argwhere(skel)
        path = sorted(points.tolist(), key=lambda p: (-p[1], p[0]))

    if len(path) < 2:
        print(f"Huruf ke-{idx+1}: path terlalu pendek.")
        continue

    chaincode = [get_freeman_direction(path[i], path[i+1]) for i in range(len(path)-1)]

    # Visualisasi
    plt.figure(figsize=(4, 4))
    plt.imshow(skel, cmap='gray')
    for i in range(len(path) - 1):
        y1, x1 = path[i]
        y2, x2 = path[i + 1]
        dx = x2 - x1
        dy = y2 - y1
        plt.arrow(x1, y1, dx, dy, head_width=0.5, head_length=0.5, fc='red', ec='red')
    plt.plot(path[0][1], path[0][0], 'go', label='Start')
    plt.plot(path[-1][1], path[-1][0], 'bo', label='End')
    plt.title(f"Huruf ke-{idx+1} - Freeman Chaincode")
    plt.axis('off')
    plt.legend()
    plt.tight_layout()
    plt.show()

    print(f"Huruf ke-{idx+1} - Freeman Chaincode:")
    print(chaincode)

    # Simpan ke CSV
    all_freeman_rows.append(["huruf", idx + 1, "", ' '.join(map(str, chaincode))])

